{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx -y pnpm@10.3.0 install --frozen-lockfile",
  "buildCommand": "npx -y pnpm@10.3.0 run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/[[...route]].ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/"
    },
    {
      "source": "/:path*",
      "destination": "/api/:path*"
    }
  ]
}
