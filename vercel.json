{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "installCommand": "npx -y pnpm@10.3.0 install --frozen-lockfile",
  "buildCommand": "npx -y pnpm@10.3.0 run build",
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "https://prdapi.fast2x.com/uploads/:path*"
    }
  ]
}
