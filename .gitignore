# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# testing
/coverage

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.development
!.env.local.enc

# typescript
*.tsbuildinfo

# tanstack start (auto-generated)
src/routeTree.gen.ts
.idea/*
public/assets/image/*
public/assets/figma/*
/public/assets/images/*
!public/assets/images/feature-icons/
!public/assets/images/feature-icons/*.svg
# 发布产物（S3 本地镜像缓存）
public/cdn/
public/sites/

# Vite 配置临时构建产物
vite.config.timestamp_*

# 构建产物与构建临时文件（均不纳入版本控制）
/dist/
# 清构建目录时用的改名备份（本机批量删除会被守卫拦，只能改名绕，用完即删）
/dist.bak-*/
/.tanstack/tmp/

/.npm-cache/
/.gitattributes
.npmrc
# TanStack Start 本地运行时目录
/.tanstack/

# 锁文件必须入库(CI/Vercel --frozen-lockfile 依赖);覆盖全局忽略规则
!pnpm-lock.yaml
