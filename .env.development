# Development defaults — auto-loaded by `vite dev` (mode=development).
#
# Published content (public/sites/, public/cdn/) is a local mirror pushed by
# prd-admin (set TMS_WEB_DIR=/Users/fansc/onecms/prd-web there) — it is
# gitignored and needs at least one publish before pages render. Override
# per-machine via .env.local (takes precedence, stays gitignored).

VITE_DATA_SOURCE=json
VITE_PUBLISH_BASE=/sites
VITE_DEV_SITE_CODE=global
